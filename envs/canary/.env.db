# Canary PostgreSQL settings
POSTGRES_IMAGE=postgres:18-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2
MAKEPAD_POSTGRES_EXPECTED_DATA_MAJOR=18
POSTGRES_DB=postgres
POSTGRES_USER=postgres
MAKEPAD_POSTGRES_DATA_PATH=/var/lib/makepad/postgres-canary
MAKEPAD_POSTGRES_SUPERUSER_PASSWORD_FILE_HOST_PATH=/etc/makepad/secrets/postgres-canary-superuser-password
MAKEPAD_POSTGRES_TLS_CERT_CONFIG=makepad_postgres_canary_tls_cert_v1
MAKEPAD_POSTGRES_TLS_KEY_SECRET=makepad_postgres_canary_tls_key_v1
MAKEPAD_POSTGRES_RUNTRACE_HBA_CONFIG=makepad_postgres_canary_runtrace_hba_v4
