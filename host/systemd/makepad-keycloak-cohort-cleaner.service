[Unit]
Description=Remove expired Keycloak cohort restore material and Docker resources
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/makepad/clean-keycloak-cohort-resources
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/tmp /var/run/docker.sock
