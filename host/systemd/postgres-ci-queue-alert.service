[Unit]
Description=Alert on Postgres JIT queue-controller failure

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/makepad/postgres-ci/alert.env
ExecStart=/usr/local/libexec/makepad/send-postgres-host-alert postgres-ci-queue-controller
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
