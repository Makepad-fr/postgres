[Unit]
Description=Encrypted Visitaki database backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/makepad/visitaki-backups/visitaki-encrypted-backup.py backup
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
