[Unit]
Description=Expire Visitaki encrypted database backups after 90 days
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/makepad/visitaki-backups/visitaki-backup-retention.py
TimeoutStartSec=75min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
